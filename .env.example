# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=business_signal_engine

# Execution Settings (daemon, oneshot, or simulation)
RUN_MODE=daemon
ENABLE_SIMULATOR=false # Set to true to activate dedicated test stream simulation module

# Country & Geographic Context (Default: Sri Lanka / Colombo)
COUNTRY_CODE=LK
LATITUDE=6.9271
LONGITUDE=79.8612

# External API Credentials (If unset, real providers skip extraction with a warning to prevent fake DB data)
GA_PROPERTY_ID=

# Meta & Facebook Graph API Credentials
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_CLIENT_TOKEN=
META_PAGE_ID= # organic Page Insights (SocialMediaProvider) — distinct from META_AD_ACCOUNT_ID

# Threads API Credentials
THREADS_APP_ID=
THREADS_APP_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_QUOTA_PROJECT_ID=
GOOGLE_REFRESH_TOKEN=

# Business/marketing calendar (BusinessCalendarProvider — distinct from the
# public-holiday CalendarProvider). Uses the same Google OAuth credentials above.
BUSINESS_CALENDAR_ID=

# Provider base URL overrides (leave unset in production; point at tools/mockserver in tests/CI)
WEATHER_BASE_URL=
META_GRAPH_BASE_URL=
CALENDAR_BASE_URL=
GA_ENDPOINT=
CALENDAR_API_ENDPOINT=

# Stripe — real-time signals arrive via webhook (not polled); STRIPE_SECRET_KEY
# is only used by the hourly reconciliation-poll safety net.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=
WEBHOOK_LISTEN_ADDR=:8090 # binds POST /webhooks/stripe in daemon mode

# Poll interval overrides (SIM-HB-01 §10). Leave unset in production — each
# provider keeps its own production default (shown here as a comment) unless
# explicitly overridden. The scenario conductor sets these to a few seconds
# for the duration of an evaluation run so a scenario with a 15-30 minute
# real-world cadence finishes in minutes instead of real hours.
GA_POLL_INTERVAL=                    # default: 5m
META_POLL_INTERVAL=                  # default: 1m
WEATHER_POLL_INTERVAL=               # default: 15m
CALENDAR_POLL_INTERVAL=              # default: 30m
PROMETHEUS_POLL_INTERVAL=            # default: 1m
SOCIAL_MEDIA_POLL_INTERVAL=          # default: 2m
BUSINESS_CALENDAR_POLL_INTERVAL=     # default: 30m
STRIPE_RECONCILIATION_POLL_INTERVAL= # default: 1h
