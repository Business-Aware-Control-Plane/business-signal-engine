# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=business_signal_engine

# Execution Settings
RUN_MODE=daemon

# Country & Geographic Context (Default: Sri Lanka / Colombo)
COUNTRY_CODE=LK
LATITUDE=6.9271
