# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=business_signal_engine

# Execution Settings (daemon, oneshot, or simulation)
RUN_MODE=daemon
ENABLE_SIMULATOR=false # Set to true to activate dedicated test stream simulation module

# Country & Geographic Context (Default: Sri Lanka / Colombo)
COUNTRY_CODE=LK
LATITUDE=6.9271
LONGITUDE=79.8612

# External API Credentials (If unset, real providers skip extraction with a warning to prevent fake DB data)
GA_PROPERTY_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
